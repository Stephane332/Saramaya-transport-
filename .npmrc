# Installation résistante aux connexions lentes ou instables.
#
# Le projet tire plusieurs centaines de mégaoctets ; sur une liaison irrégulière,
# npm abandonne au premier ECONNRESET. Ces réglages lui font réessayer longuement
# au lieu de tout interrompre.

fetch-retries=6
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
fetch-timeout=900000
