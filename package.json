{
  "name": "scaffold",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.7.0",
    "date-fns": "^4.4.0",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-gl": "~16.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sensors": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-text-extractor": "^2.0.0",
    "expo-updates": "~29.0.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/three": "^0.185.4",
    "babel-preset-expo": "~54.0.12",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/hook.mjs tests/verification.ts",
    "fumee": "npx expo export --platform web --output-dir dist --clear && EXPO_PUBLIC_MODE_AGENT=1 npx expo export --platform web --output-dir dist-agent --clear && node tests/fumee.mjs dist dist-agent",
    "verifier": "node scripts/verifier-versions.mjs && node scripts/generer-types-routes.mjs && npx tsc --noEmit && npm test && npm run invariants",
    "web:construire": "expo export --platform web --clear && node scripts/preparer-pages.mjs dist",
    "web:publier": "npm run verifier && npm run web:construire && npx eas-cli@latest deploy --prod",
    "apk": "npx eas-cli@latest build -p android --profile preview",
    "ios:build": "npx eas-cli@latest build -p ios --profile preview",
    "maj": "npm run verifier && npx eas-cli@latest update --auto",
    "types:routes": "node scripts/generer-types-routes.mjs",
    "invariants": "node --experimental-strip-types --no-warnings --import ./tests/hook.mjs tests/invariants.ts"
  },
  "private": true
}
