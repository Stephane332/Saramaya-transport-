{
  "expo": {
    "name": "Siraba",
    "slug": "siraba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "siraba",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A070E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siraba.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La caméra sert à scanner le code-barres de vos tickets papier pour les ajouter à vos voyages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D81F26"
      },
      "package": "com.siraba.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "La caméra sert à scanner le code-barres de vos tickets papier."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D81F26"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
